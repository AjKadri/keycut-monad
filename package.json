{
  "name": "keycut-monad",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/index.mjs",
      "node": "./src/server/index.mjs",
      "default": "./src/index.mjs"
    },
    "./server": {
      "browser": null,
      "node": "./src/server/index.mjs",
      "default": "./src/server/index.mjs"
    }
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build:contracts": "forge build",
    "simulate:testnet": "node scripts/run-forge.mjs simulate-deploy",
    "deploy:testnet": "node scripts/run-forge.mjs deploy",
    "simulate:approvals": "node scripts/run-forge.mjs simulate-approve",
    "approve:testnet": "node scripts/run-forge.mjs approve",
    "record:deployments": "node scripts/record-deployments.mjs",
    "record:approvals": "node scripts/record-approvals.mjs",
    "discover:seed": "node examples/discover.mjs",
    "revoke:seed": "node examples/revoke-seed.mjs",
    "explorer-links": "node scripts/print-explorer-links.mjs"
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "^1.4.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
